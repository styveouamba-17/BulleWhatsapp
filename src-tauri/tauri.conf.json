{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bulle",
  "version": "0.1.0",
  "identifier": "com.bulle.app",
  "build": {
    "frontendDist": "../overlay",
    "beforeDevCommand": "node scripts/build-sidecar.mjs",
    "beforeBuildCommand": "node scripts/build-sidecar.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bulle",
        "width": 440,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/bulle-connector"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
